{
    "name": "togglr/sdk-php",
    "description": "PHP SDK for Togglr feature flag management system",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Togglr Team",
            "email": "team@togglr.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/cache": "^6.0",
        "psr/cache": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Togglr\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Togglr\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse",
        "generate-client": "openapi-generator generate -i specs/sdk.yml -g php -o internal/generated --package-name togglr-client --additional-properties=packageName=togglr-client,projectName=togglr-sdk-php,packageVersion=1.0.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
